## ======================================================================
## 01-hardened.rules — RHEL hardened low-noise rules (single-line only)
## ======================================================================
## PERSISTENCE / HOW-TO
## 1) Place this file in /etc/audit/rules.d/ with a .rules extension.
## 2) Load & make persistent via augenrules: auditctl -D && augenrules --load
## 3) Enable at boot: systemctl enable --now auditd
## 4) Optional boot args (stronger start): grubby --update-kernel=ALL --args="audit=1 audit_backlog_limit=8192"
## 5) Optional: lock rules after validation by uncommenting "-e 2" at the very end and reload.
## 6) auditd.conf (not rules): set sane actions (space_left_action=SYSLOG, admin_space_left_action=SUSPEND, disk_full_action=SUSPEND, disk_error_action=SUSPEND, flush=INCREMENTAL_ASYNC).
## NOTES
## - x86_64 only (arch=b64). Duplicate for b32 only if you truly need 32-bit userland.
## - No invalid fields (e.g., no "name=" on syscalls).
## - Noise suppression uses safe SELinux/type/auid scoping.
## ======================================================================

## Queue / failure / rate
-b 8192
-f 1
-r 0

## Audit self-protection & configuration touch points
-w /etc/audit/ -p wa -k audit_conf
-w /sbin/auditctl -p x -k audit_tools
-w /usr/sbin/auditd -p x -k audit_tools

## Noise suppression: rpm/dnf/librepo churn in /tmp by rpm_t (legit package operations)
-a never,exit -F arch=b64 -F subj_type=rpm_t -F dir=/tmp -S open,openat,creat,truncate,ftruncate,rename,renameat,unlink,unlinkat,mkdir,mkdirat,rmdir,link,linkat,symlink,symlinkat -k _suppress_rpm_tmp

## Noise suppression: daemon/system ephemeral under /run for unset AUID (system services)
-a never,exit -F arch=b64 -F dir=/run -F auid=4294967295 -S open,openat,creat,truncate,ftruncate,rename,renameat,unlink,unlinkat,mkdir,mkdirat,rmdir,link,linkat,symlink,symlinkat -k _suppress_system_tmp

## Suspicious execution from temporary locations (persistence / LOLBins in tmp)
-w /tmp/ -p x -k tmp_exec
-w /var/tmp/ -p x -k tmp_exec
-w /dev/shm/ -p x -k tmp_exec
-w /run/shm/ -p x -k tmp_exec

## User file ops in temporary locations (real interactive users only)
-a always,exit -F arch=b64 -F dir=/tmp -F auid>=1000 -F auid!=4294967295 -S open,openat,creat,truncate,ftruncate,rename,renameat,unlink,unlinkat,mkdir,mkdirat,rmdir,link,linkat,symlink,symlinkat -k tmp_write
-a always,exit -F arch=b64 -F dir=/var/tmp -F auid>=1000 -F auid!=4294967295 -S open,openat,creat,truncate,ftruncate,rename,renameat,unlink,unlinkat,mkdir,mkdirat,rmdir,link,linkat,symlink,symlinkat -k tmp_write
-a always,exit -F arch=b64 -F dir=/dev/shm -F auid>=1000 -F auid!=4294967295 -S open,openat,creat,truncate,ftruncate,rename,renameat,unlink,unlinkat,mkdir,mkdirat,rmdir,link,linkat,symlink,symlinkat -k tmp_write

## Privilege escalation & identity modification
-a always,exit -F arch=b64 -F auid>=1000 -F auid!=4294967295 -S setuid,setreuid,setresuid,setgid,setregid,setresgid,setfsuid,setfsgid -k priv_esc
-w /usr/bin/sudo -p x -k priv_esc
-w /bin/su -p x -k priv_esc

## Credential & identity stores (MITRE TA0006/TA0004)
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
-w /etc/pam.d/ -p wa -k pam_changes

## Sudoers & privilege configuration
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers

## SSH server configuration
-w /etc/ssh/sshd_config -p wa -k sshd_config

## Cron/at persistence
-w /etc/cron.allow -p wa -k cron
-w /etc/cron.deny -p wa -k cron
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /var/spool/cron/ -p wa -k cron
-w /etc/at.deny -p wa -k at
-w /var/spool/at/ -p wa -k at

## Module load/unload (kernel tampering)
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k module_mgmt

## Time changes (defense evasion / anti-forensics)
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time_change
-w /etc/localtime -p wa -k time_change

## Network config changes (lateral movement / C2)
-w /etc/hosts -p wa -k net_conf
-w /etc/resolv.conf -p wa -k net_conf
-w /etc/hostname -p wa -k net_conf
-w /etc/NetworkManager/ -p wa -k net_conf

## System services & persistence via systemd
-w /etc/systemd/ -p wa -k systemd_changes

## SELinux policy / MAC changes
-w /etc/selinux/ -p wa -k mac_policy
-w /usr/sbin/semanage -p x -k mac_policy

## Capabilities tooling (files gaining caps)
-w /usr/sbin/setcap -p x -k file_caps
-w /usr/sbin/getcap -p x -k file_caps

## Security-sensitive binaries execution (suspicious use)
-w /usr/bin/chsh -p x -k priv_esc
-w /usr/bin/chfn -p x -k priv_esc
-w /usr/sbin/usermod -p x -k identity
-w /usr/sbin/useradd -p x -k identity
-w /usr/sbin/userdel -p x -k identity
-w /usr/sbin/groupadd -p x -k identity
-w /usr/sbin/groupdel -p x -k identity
-w /usr/sbin/groupmod -p x -k identity
-w /usr/sbin/visudo -p x -k sudoers

## Sysctl / kernel params persistence
-w /etc/sysctl.conf -p wa -k sysctl
-w /etc/sysctl.d/ -p wa -k sysctl

## Lastlog / wtmp/btmp modifications (coverup attempts)
-w /var/log/lastlog -p wa -k log_integrity
-w /var/log/wtmp -p wa -k log_integrity
-w /var/log/btmp -p wa -k log_integrity

## Optional: Lock the ruleset (uncomment after verifying load is clean)
## -e 2

